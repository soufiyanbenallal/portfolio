{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "~/components/*": ["./app/kits/polaris/*"],
      "~/components/ui/*": ["./app/kits/polaris/ui/*"]
    },
    "types": ["@shopify/polaris-types"]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "app/kits/polaris/Billing",
    "app/kits/polaris/conditions",
    "app/kits/polaris/ContactEmail",
    "app/kits/polaris/EmailReports",
    "app/kits/polaris/Integrations",
    "app/kits/polaris/LibraryIcons",
    "app/kits/polaris/MerchantApi",
    "app/kits/polaris/ReviewRequest",
    "app/kits/polaris/support",
    "app/kits/polaris/ThemeAppStatus",
    "app/kits/polaris/ui/actions/FloatingButton.tsx",
    "app/kits/polaris/ui/feedbacks/SomethingWentWrong.tsx",
    "app/kits/polaris/ui/forms/Autocomplete.tsx",
    "app/kits/polaris/ui/forms/Table",
    "app/kits/polaris/ui/layouts/SortableList.tsx"
  ]
}
